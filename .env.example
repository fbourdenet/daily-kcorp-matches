# Token du bot Discord (Developer Portal → Bot → Reset Token)
DISCORD_BOT_TOKEN=

# ID du salon cible (clic droit sur le salon → Copier l'identifiant, mode développeur requis)
DISCORD_CHANNEL_ID=

# Optionnel : rejouer une journée précise au format YYYY-MM-DD (heure de Paris)
# REPLAY_DATE=2026-09-24

# Optionnel : User-Agent envoyé à Liquipedia.
# Le ToS exige un identifiant de projet + un contact, sinon risque de blocage.
# LIQUIPEDIA_USER_AGENT=DailyKcMatches/1.0 (https://github.com/fbourdenet/daily-kcorp-matches)
