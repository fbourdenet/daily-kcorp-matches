{
  "name": "daily-kc-matches",
  "version": "1.0.0",
  "description": "A project to fetch and manage daily KC matches",
  "main": "src/index.ts",
  "scripts": {
    "start": "tsx src/index.ts",
    "test": "tsx --test tests/liquipedia.test.ts tests/match.test.ts tests/discord.test.ts tests/fetch.test.ts",
    "lint": "eslint src tests --ext .ts",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts"
  },
