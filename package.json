    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "domhandler": "^6.0.1",
    "eslint": "^8.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.0.0"
  }
